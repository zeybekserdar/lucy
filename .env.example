# Copy to .env and fill in. Docker Compose reads it automatically.
# The ntfy values are only used on first start; after that, Settings takes over.

# Choose a topic nobody can guess: topics on ntfy.sh are public.
# Generate one with: openssl rand -hex 12
LUCY_NTFY_TOPIC=

# Your own ntfy server and its access token, if you have one
#LUCY_NTFY_SERVER=https://ntfy.sh
#LUCY_NTFY_TOKEN=

# Address your phone uses to reach Lucy, for notification links and the icon.
# The address entered in Settings takes precedence.
#LUCY_PUBLIC_URL=http://192.168.1.10:8080

#LUCY_PORT=8080
#LUCY_LANG=tr
#TZ=Europe/Istanbul
