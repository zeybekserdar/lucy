# Copy to .env and fill in. Docker Compose reads it automatically.
# ntfy değerleri yalnızca ilk açılışta kullanılır; sonrasında Ayarlar ekranı geçerlidir.

# Tahmin edilemez bir konu seç: ntfy.sh üzerindeki konular herkese açıktır.
# Örnek üretmek için: openssl rand -hex 12
LUCY_NTFY_TOPIC=

# Kendi ntfy sunucun varsa adresi ve erişim token'ı
#LUCY_NTFY_SERVER=https://ntfy.sh
#LUCY_NTFY_TOKEN=

# Bildirime tıklayınca açılacak adres
#LUCY_PUBLIC_URL=http://192.168.1.10:8080

#LUCY_PORT=8080
#LUCY_LANG=tr
#TZ=Europe/Istanbul
